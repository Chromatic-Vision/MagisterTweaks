{
  "manifest_version": 3,
  "name": "MagisterTweaks",
  "version": "0.1.3",
  "description": "Useful tweaks for *.magister.net",
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "declarativeNetRequestWithHostAccess"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.magister.net/*"],
      "js": ["contentScript.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rulesets.json"
      }
    ]
  },
  "host_permissions": ["https://*.magister.net/"],
  "web_accessible_resources": [
    {
      "resources": ["*/*.png", "*/*.gif, */*.mp4"],
      "matches": ["<all_urls>"]
    }
  ]
}